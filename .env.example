# ==========================================================
# ENVIRONMENT VARIABLES CONFIGURATION (KEUANGAN APP)
# ==========================================================

# 1. Supabase PostgreSQL & Auth Credentials
# Dapatkan kredensial ini dari Project Settings -> API di Supabase Dashboard (supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google OAuth & Cloud APIs (Sheets & Drive Integration)
# Dapatkan kredensial ini dari Google Cloud Console (console.cloud.google.com)
# Aktifkan Google Sheets API dan Google Drive API
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# 3. App Environment
NODE_ENV=development
